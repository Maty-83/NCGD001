  m_Name: 
  m_EditorClassIdentifier: 
  textPanelImage: {fileID: 773825588}
  storyText: {fileID: 2110948973}
  fullText: "Desperation breeds horror. Seeking an end to the carnage, the Americans
    unleash a weapon beyond comprehension \u2014 the nuclear bomb. A sun is born
    over the city. The sky turns white. The earth trembles. In an instant, tens of
    thousands vanish in flame. The world holds its breath. You are caught in the
    blast \u2014 yet fate intervenes."
  narratorClip: {fileID: 8300000, guid: 377b425dcf002524fb84d63e2817fcac, type: 3}
  panelFadeDuration: 1
  charSpeed: 0.03
