  m_Name: 
  m_EditorClassIdentifier: 
  textPanelImage: {fileID: 337617979}
  storyText: {fileID: 10487341}
  fullText: "The blast did not claim you. Instead, it marked you. Your body survived,
    but your soul was forever altered. Touched by both death and life, you stand
    between worlds. Haunted by visions, empowered by a strange force, you awaken
    in the ruins. Now, you must fight not only for survival \u2014 but for the fate
    of both realms."
  narratorClip: {fileID: 8300000, guid: ca098f2e29a0be6418266d015e15fc66, type: 3}
  panelFadeDuration: 1
  charSpeed: 0.03
