  m_Script: {fileID: 11500000, guid: be4b3182daa3a3746b71318249159dc0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textPanelImage: {fileID: 1925838081}
  storyText: {fileID: 1069571608}
  fullText: "The agony of the dying, the sorrow of the lost, the sheer force unleashed
    by the bomb tears more than flesh and stone.\r\nIt rends the veil between the
    living and the dead. From the shadows, ancient yokai awaken \u2014 spirits twisted
    by hatred and hunger. Drawn to the shattered world, they seek dominion over the
    realm of men. The war was meant to end \u2014 but a darker one is beginning."
  narratorClip: {fileID: 8300000, guid: 9d4bd178d421c9e48b4e54a24480d443, type: 3}
  panelFadeDuration: 1
  charSpeed: 0.03
