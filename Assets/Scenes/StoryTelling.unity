  m_Script: {fileID: 11500000, guid: be4b3182daa3a3746b71318249159dc0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textPanelImage: {fileID: 1156425505}
  storyText: {fileID: 1785731326}
  fullText: "The Pacific is ablaze. You are a soldier of the Empire of Japan \u2014
    a man of duty, fighting a battle long since lost in blood and ash.\r\nThe American
    advance is relentless; your homeland stands defiant, yet weary. Cities crumble
    under steel rain, comrades vanish one by one. Honor binds you, yet doubt gnaws
    your heart. You fight on, knowing that to surrender is unthinkable. But deep
    down, you sense it: this war has become a storm with no end."
  narratorClip: {fileID: 8300000, guid: 18d776e8e009aa64687883bd917a48fe, type: 3}
  panelFadeDuration: 1
  charSpeed: 0.03
